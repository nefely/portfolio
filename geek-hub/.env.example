# Спільний Supabase-проєкт (той самий, що й job-platform / task-manager).
# Значення — Supabase Dashboard → Project Settings → API,
# або скопіювати з portfolio/job-platform/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Кнопка "Continue with Google". Вмикати лише після налаштування провайдера
# Google у Supabase (Authentication → Providers), інакше вхід падає з 400.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
